# Coverage configuration for ProcessNet Knowledge Base Extraction
# Handles kebab-case source file naming

[run]
source = src
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
parallel = True
branch = True

[report]
precision = 2
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
